generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  image         String?
  icon          String?
  productCount  Int       @default(0)
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
  stocks        Stock[]

  @@map("categories")
}

// ─── STOCK (unified inventory + shop item) ───────────────────────────
model Stock {
  id                     Int            @id @default(autoincrement())
  slug                   String?        @unique
  nameEn                 String
  nameAr                 String
  descriptionEn          String?
  descriptionAr          String?
  images                 String[]
  categoryId             Int?
  category               Category?      @relation(fields: [categoryId], references: [id])
  type                   String         @default("single") // "single" | "bundle"

  // ─── Legacy purchase fields (kept for historical data) ───
  purchaseUnit           String         @default("gram")
  purchaseQuantity       Float          @default(0)
  purchasePrice          Float          @default(0)
  costPerGram            Float          @default(0)
  currentStockGrams      Float          @default(0)
  totalStockGrams        Float          @default(0)
  lowStockThresholdGrams Float          @default(500)

  // ─── Piece-based inventory ───
  currentStockPcs        Int            @default(0)
  lowStockThresholdPcs   Int            @default(5)

  // ─── Pricing (bundles set a fixed sell price) ───
  price                  Float?
  originalPrice          Float?

  // ─── Shop / product fields ───
  variants               Json?          // [{ label, grams, price }]
  labels                 Json?          // { isNew, isHot, isSale, salePercent, isLimited }
  rating                 Float          @default(0)
  reviewCount            Int            @default(0)
  featured               Boolean        @default(false)
  bestSeller             Boolean        @default(false)

  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  restocks               StockRestock[]
  products               Product[]
  bundleContents         BundleItem[]   @relation("BundleContents")
  inBundles              BundleItem[]   @relation("BundleIngredients")
  orderItems             OrderItem[]
  reviews                Review[]
  pricingRule            PricingRule?

  @@index([categoryId, active])
  @@index([featured, active])
  @@index([bestSeller, active])
  @@index([active, createdAt])
  @@map("stocks")
}

model PricingRule {
  id            Int      @id @default(autoincrement())
  stockId       Int      @unique
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  markupPercent Float    @default(30)
  updatedAt     DateTime @updatedAt

  @@map("pricing_rules")
}

model StockRestock {
  id            Int      @id @default(autoincrement())
  stockId       Int
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  // Legacy gram fields (kept for historical records)
  addedGrams    Float    @default(0)
  purchasePrice Float    @default(0)
  purchaseUnit  String   @default("gram")
  purchaseQty   Float    @default(0)
  // New pcs-based restock
  addedPcs      Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  @@map("stock_restocks")
}

model Product {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  images        String[]
  type          String      @default("single") // "single" | "bundle"

  // For type = single: link to a single Stock entry; variants define sellable gram sizes.
  stockId       Int?
  stock         Stock?      @relation(fields: [stockId], references: [id])

  // For type = bundle: admin-set sell price (cost computed from linked BundleItems).
  price         Float?
  originalPrice Float?

  // variants = [{ weightLabel: "100g", grams: 100 }, ...] for single products
  variants      Json?

  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])

  bundleStock   Int         @default(0)

  labels        Json?
  rating        Float       @default(0)
  reviewCount   Int         @default(0)
  active        Boolean     @default(true)
  featured      Boolean     @default(false)
  bestSeller    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
  bundleItems   BundleItem[]

  @@index([categoryId, active])
  @@index([featured, active])
  @@index([bestSeller, active])
  @@index([active, createdAt])
  @@map("products")
}

model BundleItem {
  id            Int      @id @default(autoincrement())
  // Legacy: bundle Product (kept during migration)
  productId     Int?
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  // New: the bundle is now a Stock entry
  bundleStockId Int?
  bundleStock   Stock?   @relation("BundleContents", fields: [bundleStockId], references: [id], onDelete: Cascade)
  // Ingredient stock item (unchanged)
  stockId       Int
  stock         Stock    @relation("BundleIngredients", fields: [stockId], references: [id])
  gramsPerUnit  Float    @default(0)
  quantity      Int      @default(1)

  @@map("bundle_items")
}

model Customer {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String?
  address   String?
  building  String?
  floor     String?
  apartment String?
  city      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([phone])
  @@map("customers")
}

model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique
  customerId     Int
  customer       Customer    @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  subtotal       Float
  deliveryFee    Float       @default(0)
  discountAmount Float       @default(0)
  grandTotal     Float
  paymentMethod  String      @default("cash")
  paymentStatus  String      @default("pending")
  status         String      @default("pending")
  deliveryZone   String?
  promoCode      String?
  notes          String?
  stockRestored  Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId, status])
  @@map("orders")
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id])
  // Legacy product reference (kept for old orders)
  productId       Int?
  product         Product? @relation(fields: [productId], references: [id])
  // New stock reference (used for new orders)
  stockId         Int?
  stock           Stock?   @relation(fields: [stockId], references: [id])
  nameEn          String
  nameAr          String
  price           Float
  quantity        Int
  weight          String?
  grams           Float?
  gramsDeducted   Float?
  bundleBreakdown Json?
  type            String   @default("single")

  @@map("order_items")
}

model Review {
  id        Int      @id @default(autoincrement())
  // Legacy product reference (kept for old reviews)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  // New stock reference
  stockId   Int?
  stock     Stock?   @relation(fields: [stockId], references: [id])
  name      String
  rating    Int
  text      String?
  verified  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String
  value     Float
  minOrder  Float     @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("promo_codes")
}

model DeliveryZone {
  id              Int     @id @default(autoincrement())
  nameEn          String
  nameAr          String
  price           Float
  estimatedTime   String
  estimatedTimeAr String
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  @@map("delivery_zones")
}

model SiteSetting {
  id              Int      @id @default(1)
  topBannerEn     String
  topBannerAr     String
  promoTitleEn    String
  promoTitleAr    String
  promoSubtitleEn String
  promoSubtitleAr String
  promoCode              String?  @default("WELCOME10")
  promoPercent           Float    @default(10)
  promoActive            Boolean  @default(true)
  freeDeliveryThreshold  Float    @default(200)
  freeDeliveryEnabled    Boolean  @default(true)
  tickerItemsEn  String[]
  tickerItemsAr  String[]
  workingHoursEn  String   @default("Daily: 8:00 AM - 11:00 PM")
  workingHoursAr  String   @default("يومياً: 8:00 صباحاً - 11:00 مساءً")
  whatsappNumber  String   @default("97466556393")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}